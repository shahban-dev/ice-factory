# Copy this file to .env and fill in real values. NEVER commit .env.
# Production values are required; the development fallbacks in settings.py
# only apply when DEBUG=True.

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

# False in production. True ONLY for local development on your own machine
# (localhost, or your local network for phone testing). Never True on a
# live server: with DEBUG on, a bad URL shows full tracebacks.
DEBUG=False

# Production example (PostgreSQL 16 on the VPS):
# DATABASE_URL=postgres://icefactory:STRONG-PASSWORD@127.0.0.1:5432/icefactory
# Local development falls back to SQLite when this is left unset.

# Comma-separated hostnames that may serve the site, e.g.:
# ALLOWED_HOSTS=ice.example.com,www.ice.example.com
ALLOWED_HOSTS=127.0.0.1,localhost

# The Django admin lives here instead of /admin/ (superusers only).
# Change it to something private, e.g. ADMIN_URL=my-secret-panel/
ADMIN_URL=site-admin/

# Backups (used by `python manage.py backup_db`):
# Where backup files are kept. Defaults to <project>/backups.
# BACKUP_DIR=/var/backups/icefactory
# Passphrase for AES-256-CBC encryption of stored backups. Without it,
# backups are stored compressed but UNENCRYPTED (the log says so).
# BACKUP_ENCRYPTION_PASSPHRASE=a-long-random-passphrase
# rclone remote for the off-server copy, e.g. "b2:ice-factory-backups"
# or "gdrive:ice-factory-backups". Without it, no upload happens.
# BACKUP_RCLONE_REMOTE=
